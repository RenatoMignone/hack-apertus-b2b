# Copy to an ignored .env; do not commit credentials.
# Application model configuration. Never commit a real key.
# CSCS through Keera; see docs/data/INFERENCE_CONFIGURATION.md.
LLM_NAME=apertus-v1-5-70b
LLM_BASE_URL=https://gateway.keera.ch/api/v1
LLM_API_KEY=replace-with-keera-team-key

# Deployment mode applies to reasoning and embedding adapters.
# Connected Keera access cannot be used in offline mode.
DEPLOYMENT_MODE=connected
# Hosted connected deployment supplied by Eric; verified JSON must match the corpus.
# HF token is secret; obtain privately. External endpoint is connected-only.
EMBEDDING_BACKEND=hf
EMBEDDING_ENDPOINT_URL=https://6ad51265d2d0ab8296e5a3cd.endpoints.huggingface.cloud
HF_TOKEN=
EMBEDDING_MODEL_ID=google/embeddinggemma-2
EMBEDDING_MODEL_REVISION=914f7f89142e33e77833254d9c9b90c3cef7303b
EMBEDDING_DIMENSION=768
# Serving image (operator provenance): ghcr.io/huggingface/hf-serve:b805e0c-cpu
# Internal container port 8080; clients use the public HTTPS endpoint on 443.
# Local pinned tokenizer.json only; hosted mode needs no local model weights.
EMBEDDING_TOKENIZER_PATH=

# Developer connection through the shared host's SSH tunnels.
# Replace placeholders privately; never use the migrator role in application code.
DATABASE_URL=postgresql+psycopg://DEV_ROLE:DEV_PASSWORD@127.0.0.1:15432/navigator
LANGGRAPH_DATABASE_URL=
ARTIFACT_BACKEND=s3
S3_ENDPOINT_URL=http://127.0.0.1:19000
S3_BUCKET=navigator
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Runtime lane A: explicit server-side identity bindings, never frontend secrets.
# JSON objects require token_sha256 (not raw bearer token), principal_id, namespace.
# Optional database_url_env selects a server-owned per-role DSN variable.
RUNTIME_AUTH_BINDINGS=[]
RUNTIME_PROFILE_ID=
# Work with completed searchable chunks while ingestion continues. Each new run
# captures its authorized evidence; no shared publication or active pointer needed.
RUNTIME_CORPUS_MODE=live
# Optional only when the profile has no taxonomy_version_id configuration field.
RUNTIME_LIVE_TAXONOMY_ID=
RUNTIME_CORS_ORIGINS=http://localhost:5173
RUNTIME_DEADLINE_SECONDS=600
RUNTIME_RESEARCH_ROUNDS=3
RUNTIME_MAX_OUTPUT_TOKENS=4096
RUNTIME_MAX_TOOL_CALLS=11
RUNTIME_WORKER_LEASE_SECONDS=60
# B/C supply synchronous factories(settings=..., engine=..., artifacts=...).
# Missing adapters report unavailable. Production never auto-loads fixtures.
RUNTIME_REASONING_FACTORY=backend.application.factories:reasoning
RUNTIME_BACKBONE_FACTORY=backend.application.factories:backbone
RUNTIME_WEB_FACTORY=
RUNTIME_PDF_FACTORY=backend.application.factories:pdf
# Integrated deterministic PDF identities.
RUNTIME_TEMPLATE_VERSION=challenge-v1
RUNTIME_RENDERER_VERSION=reportlab-v1
# Explicit supplied asset path, relative to the repository root for local commands.
# The runtime Dockerfile sets its packaged /app/assets/... path instead.
RUNTIME_PDF_LOGO_PATH=docs/provided_material/Logo_SF_BE_EN.png
# Verified ModelConfiguration JSON, matching the published snapshot exactly.
# Local mode uses local model assets; hf uses endpoint plus a pinned local tokenizer.
# Startup never downloads weights/tokenizers or builds a corpus.
EMBEDDING_CONFIGURATION=
EMBEDDING_MODEL_PATH=
RERANKER_CONFIGURATION=
RERANKER_MODEL_PATH=
MODEL_DEVICE=cpu
# Optional connected public research. Enable its factory only after provisioning.
# RUNTIME_WEB_FACTORY=backend.application.factories:web
WEB_USER_AGENT=BernExpertiseNavigator/0.1 (HackApertus public research)
WEB_ALLOWED_HOSTS=
# Keyless private SearXNG + isolated Crawl4AI. No browser needed for default search.
WEB_DISCOVERY_PROVIDER=searxng
WEB_SEARCH_URL=http://127.0.0.1:18888
WEB_SEARCH_ENGINES=duckduckgo,yahoo
# Locally generated crypto secret for the sidecar, not a provider API key.
SEARXNG_SECRET=
# Optional WEB_DISCOVERY_PROVIDER=browser diagnostic adapter only.
# Empty selects Playwright-managed Chromium; otherwise an absolute Chrome path.
WEB_BROWSER_EXECUTABLE=
WEB_BROWSER_TIMEOUT_SECONDS=25
# Absolute path to the dedicated crawler venv Python (requirements.crawler.lock).
WEB_CRAWL4AI_PYTHON=
# Only needed when WEB_DISCOVERY_PROVIDER=brave (explicit API alternative).
BRAVE_API_KEY=
# Optional masked local Langfuse. Never enable automatic external LangSmith tracing.
LANGFUSE_BASE_URL=http://127.0.0.1:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGSMITH_TRACING=false
LANGCHAIN_TRACING_V2=false
