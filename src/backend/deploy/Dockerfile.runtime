# Supply an operator-verified, digest-pinned Python 3.13 image when building.
ARG PYTHON_RUNTIME_IMAGE
FROM ${PYTHON_RUNTIME_IMAGE}
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY src/backend/requirements.lock /tmp/requirements.lock
RUN pip install --no-cache-dir -r /tmp/requirements.lock
COPY src/backend /app/src/backend
COPY docs/provided_material/Logo_SF_BE_EN.png /app/assets/Logo_SF_BE_EN.png
COPY docs/provided_material/powerpoint_template.pptx /app/assets/powerpoint_template.pptx
ENV RUNTIME_PPTX_TEMPLATE_PATH=/app/assets/powerpoint_template.pptx
ENV RUNTIME_PDF_LOGO_PATH=/app/assets/Logo_SF_BE_EN.png
RUN pip install --no-cache-dir --no-deps /app/src/backend \
    && useradd --create-home --uid 10001 navigator \
    && mkdir -p /app/.local/artifacts && chown -R navigator:navigator /app/.local
USER navigator
ENTRYPOINT ["navigator-runtime"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8000"]
