{
  "name": "bern-navigator-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:transport && npm run test:components",
    "test:transport": "node --experimental-strip-types --test tests/*.test.ts",
    "test:components": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.1.0",
    "@radix-ui/themes": "^3.3.0",
    "d3-sankey": "^0.12.3",
    "jszip": "^3.10.1",
    "lucide-react": "^0.460.0",
    "pdfmake": "^0.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/d3-sankey": "^0.12.4",
    "@types/pdfmake": "^0.2.9",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.6.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
